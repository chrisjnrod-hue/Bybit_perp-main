# ---------------------------
# .env — high-throughput defaults (use with caution)
# Each variable below includes a short description and a suggested high-performance value.
# Reduce CONCURRENCY / RATE_LIMIT_RPS / REQUEST_BATCH_SIZE if you hit API rate limits.
# ---------------------------

# Network / exchange mode -----------------------------------------------------
# MAINNET: run against mainnet (true) or testnet (false).
MAINNET=true

# USE_WS: use websocket subscriptions when available for lower-latency updates (true/false).
# HIGH PERFORMANCE: enable websockets if supported by client / exchange.
USE_WS=true

# Bybit API credentials (required for live trading)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Symbol filters --------------------------------------------------------------
# Comma-separated list of stablecoins to exclude from symbol discovery.
EXCLUDE_STABLECOINS=USDT,BUSD,USDC

# Timeframes ------------------------------------------------------------------
# ROOT_TFS: root timeframes used to detect flips and schedule full pushes (comma-separated).
# Use numeric-minute strings (e.g., 60,240) and "D" for daily. For maximum coverage keep 60,240,D.
ROOT_TFS=60,240,D

# MTF_TFS: multi-timeframe set to request/subscribe for secondary checks.
MTF_TFS=5,15,60,240,D

# Scheduling & seeding --------------------------------------------------------
# ROOT_SCAN_INTERVAL: seconds between full scan boundaries.
# 0 = align to every 5-minute boundary (recommended for "every 5m" behavior).
ROOT_SCAN_INTERVAL=0

# KLINE_SEED_LIMIT: number of historical candles to seed per TF when seeding.
# Larger values increase accuracy but increase initial load. High-performance recommended:
KLINE_SEED_LIMIT=300

# Concurrency & rate limiting (HIGH values for maximum throughput; tune to avoid rate-limits)
# RATE_LIMIT_RPS: target requests per second. Set close to your exchange allowance (aggressive example: 20).
RATE_LIMIT_RPS=20.0

# CONCURRENCY: number of concurrent worker tasks for seeding/scan work (higher = more parallel)
CONCURRENCY=60

# MAX_CONCURRENT_REQUESTS: maximum simultaneous HTTP requests to exchange (lower to be safe)
MAX_CONCURRENT_REQUESTS=50

# REQUEST_BATCH_SIZE: size of symbol batches processed per micro-batch
REQUEST_BATCH_SIZE=100

# REQUEST_BATCH_DELAY: pause (seconds) between request batches to reduce bursts
REQUEST_BATCH_DELAY=0.05

# REST_POLL_INTERVAL: REST poller sleep interval in seconds when WS is unavailable (shorter = more frequent)
REST_POLL_INTERVAL=5

# Trading & risk (defaults tuned for high throughput; trading enable with care) ---
# TRADE_ENABLED: true to place live orders, false for simulation.
TRADE_ENABLED=false

# MAX_OPEN_TRADES: maximum concurrent open positions allowed
MAX_OPEN_TRADES=12

# TP_PERCENT / SL_PERCENT: default take-profit and stop-loss for created trades
TP_PERCENT=10.5
SL_PERCENT=1.0

# Position sizing & execution --------------------------------------------------
POSITION_SIZING_MODE=auto
FIXED_QTY=1.0
LEVERAGE=20
MAX_SLIPPAGE=0.5
MAX_SPREAD_PERCENT=0.5

# Scoring & thresholds --------------------------------------------------------
MACD_HIST_THRESHOLD=0.0
VOLUME_CHANGE_24H_THRESHOLD=0.0

# Volume / volume-change gating (trade-open gate only) ------------------------
# VOLUME_FILTER_ENABLED: enable gating by exchange-reported 24h volume-change
VOLUME_FILTER_ENABLED=true

# VOLUME_MIN_CHANGE_PCT: minimum fractional volume-change required (0.05 = 5%)
# Set to 0.0 to accept any exchange-reported change.
VOLUME_MIN_CHANGE_PCT=0.0

# MIN_24H_VOLUME_USDT: minimum 24h quote (USDT) volume required to allow opening trades.
# Set to 0 to disable; increase to filter illiquid markets (e.g., 500000 = $500k).
MIN_24H_VOLUME_USDT=0

# TRADE_NO_NEG_VOL: block opens if exchange-reported volume change is negative
TRADE_NO_NEG_VOL=true

# Market cap filter (0 = disabled)
MARKET_CAP_MIN=0

# Root / MTF filters ----------------------------------------------------------
ROOT_FILTER=true
ROOT_TOP_N=6

MTF_FILTER=false
MTF_REQUIRE_RISING=true
MTF_1D_ALLOW_NEGATIVE_RISING=true
MTF_SLOPE_LOOKBACK=3

# Flip / dedupe / timing ------------------------------------------------------
# FLIP_CANDLE_AGE_MAX_SEC: max allowed age of flip candle to be considered "fresh" (lower = stricter)
# For maximum speed/use more permissive acceptance set to 300; set lower to be strict
FLIP_CANDLE_AGE_MAX_SEC=300

# SIGNAL_DEDUP_WINDOW: seconds to dedupe same (symbol,tf,candle_start) re-triggers
SIGNAL_DEDUP_WINDOW=300

# TV Rating / prioritization --------------------------------------------------
TRADE_RATING_MIN=0.25
TRADE_RATING_PRIORITIZE=true
TV_RATING_WEIGHT=0.5
PRIORITIZE_SLOT_ORDER=240,D,60

# Telegram / notifications ---------------------------------------------------
TELEGRAM_BOT_TOKEN=8195507774:AAGceiXafAcNrzjs9o8j8wr9B-amR4cJX-g
TELEGRAM_CHAT_ID=1735382824
# Logging / diagnostics -------------------------------------------------------
LOG_LEVEL=INFO
DIAGNOSTIC_MODE=false
DEBUG_SURGICAL_LOGS=false

# Misc (backwards compatibility)
TRADE_RATING_MIN_VAL=${TRADE_RATING_MIN}
