# .env.example
# Complete environment variables reference for the scanner bot
# Copy this file to .env and update values as needed

# ============================================================================
# NETWORK & AUTHENTICATION
# ============================================================================

# Use mainnet (true) or testnet (false)
MAINNET=true

# Enable WebSocket for real-time kline updates (true) or REST polling (false)
USE_WS=false

# Bybit API credentials (leave empty to run in simulation mode)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ============================================================================
# SYMBOL FILTERING
# ============================================================================

# Comma-separated list of stablecoins to exclude from scanning
# Default: USDT,BUSD,USDC
EXCLUDE_STABLECOINS=USDT,BUSD,USDC

# ============================================================================
# TIMEFRAMES
# ============================================================================

# Root timeframes for signal detection (comma-separated)
# Format: numeric minutes (5, 15, 60, 240) or "D" for daily
# Default: 60,240,D
ROOT_TFS=60,240,D

# Multi-timeframe alignment check timeframes (comma-separated)
# Default: 5,15,60,240,D
MTF_TFS=5,15,60,240,D

# ============================================================================
# SCANNING INTERVALS & DATA
# ============================================================================

# Root scan interval in seconds
# Set to 0 to run scanner on each 5-minute candle open (recommended)
# Set to positive integer (e.g., 120) for fixed interval scanning
# Default: 120
ROOT_SCAN_INTERVAL=120

# Number of historical candles to fetch during symbol seeding
# Recommended: 50-100 (MACD requires minimum 26)
# Default: 50
KLINE_SEED_LIMIT=50

# ============================================================================
# CONCURRENCY & RATE LIMITING
# ============================================================================

# API requests per second (rate limiting)
# Default: 5.0
RATE_LIMIT_RPS=5.0

# Number of concurrent symbol checks per scan cycle
# Higher = faster scanning but more API load
# Recommended: 20-50
# Default: 30
CONCURRENCY=30

# Maximum concurrent HTTP requests to API
# Default: 10
MAX_CONCURRENT_REQUESTS=10

# Batch size for symbol checks (requests per batch)
# Default: 15
REQUEST_BATCH_SIZE=15

# Delay between batches in seconds (to avoid rate limits)
# Default: 0.2
REQUEST_BATCH_DELAY=0.2

# REST polling interval in seconds (fallback when WS unavailable)
# Default: 10
REST_POLL_INTERVAL=10

# ============================================================================
# TRADING SETTINGS
# ============================================================================

# Enable live trading (true) or simulation mode (false)
# IMPORTANT: Requires BYBIT_API_KEY and BYBIT_API_SECRET
# Default: false
TRADE_ENABLED=false

# Maximum number of concurrent open trades
# Default: 3
MAX_OPEN_TRADES=3

# Take profit target as percentage (e.g., 2.0 = +2%)
# Default: 2.0
TP_PERCENT=2.0

# Stop loss trigger as percentage (e.g., 1.0 = -1%)
# Default: 1.0
SL_PERCENT=1.0

# Breakeven trigger percentage (move to breakeven at this profit %)
# Default: 0.5
BREAKEVEN_PERCENT=0.5

# Breakeven activation threshold percentage (activate breakeven at this profit %)
# Default: 1.0
BREAKEVEN_TRIGGER_PERCENT=1.0

# Enable high/low breakeven mode (use highest/lowest price during trade)
# Default: true
BREAKEVEN_HL=true

# ============================================================================
# POSITION SIZING
# ============================================================================

# Position sizing mode: "auto" (risk-based) or "fixed" (FIXED_QTY)
# Default: auto
POSITION_SIZING_MODE=auto

# Fixed quantity per trade (used when POSITION_SIZING_MODE=fixed)
# Default: 1.0
FIXED_QTY=1.0

# ============================================================================
# SIGNAL FILTERING & THRESHOLDS
# ============================================================================

# MACD histogram threshold for flip detection
# 0.0 = any positive flip accepted
# Default: 0.0
MACD_HIST_THRESHOLD=0.0

# 24-hour volume change threshold (decimal; 0.0 = no filter)
# Default: 0.0
VOLUME_CHANGE_24H_THRESHOLD=0.0

# ============================================================================
# VOLUME FILTERING
# ============================================================================

# Enable volume change filter for trade opens
# true = require minimum 24h volume change to open trades
# false = ignore volume, open trades freely
# Default: true
VOLUME_FILTER_ENABLED=true

# Minimum 24-hour volume change % required for trade opens
# Decimal format: 0.05 = +5%, 0.10 = +10%
# 0.0 = any positive change accepted
# Default: 0.0
VOLUME_MIN_CHANGE_PCT=0.0

# ============================================================================
# TRADE FILTERING BY ROOT TIMEFRAME
# ============================================================================

# Enable ROOT_FILTER: allocate MAX_OPEN_TRADES slots by ROOT_TFS
# true = distribute slots across root TFs according to PRIORITIZE_SLOT_ORDER
# false = no TF-based slot allocation
# Default: false
ROOT_FILTER=false

# Top N signals per root TF when ROOT_FILTER=true
# Default: 3
ROOT_TOP_N=3

# Slot allocation order (comma-separated list of TFs)
# Highest priority first; slots filled in this order
# Default: 240,D,60
PRIORITIZE_SLOT_ORDER=240,D,60

# ============================================================================
# MULTI-TIMEFRAME (MTF) ALIGNMENT FILTERING
# ============================================================================

# Enable MTF alignment checks (require lower TFs to be positive)
# Default: false
MTF_FILTER=false

# Require rising confirmation on daily timeframe when only D is negative
# Default: true
MTF_REQUIRE_RISING=true

# Allow daily timeframe to be negative but rising (uptrend in progress)
# Default: true
MTF_1D_ALLOW_NEGATIVE_RISING=true

# Lookback periods for daily slope calculation (for rising detection)
# Default: 3
MTF_SLOPE_LOOKBACK=3

# ============================================================================
# FLIP CANDLE & SIGNAL DEDUPLICATION
# ============================================================================

# Maximum age (seconds) of a candle where flip is considered "fresh"
# Prevents mid-candle flips from opening trades
# 0 = accept flips at any age (not recommended)
# Recommended: 300 (5 min), 600 (10 min), 900 (15 min)
# Default: 300
FLIP_CANDLE_AGE_MAX_SEC=300

# Signal deduplication window in seconds
# Prevents same candle from triggering multiple signals across scan cycles
# Tracks: (symbol, timeframe, candle_open_time)
# 0 = disable deduplication (not recommended; causes duplicates)
# Default: 60
SIGNAL_DEDUP_WINDOW=60

# ============================================================================
# TRADINGVIEW-LIKE RATING FILTERS
# ============================================================================

# Minimum TV rating score required to open a trade
# Scale: 0.0 (Neutral), 0.25 (Buy), 0.6 (Strong Buy)
# 0.0 = disable filter (allow any aligned signal regardless of TV rating)
# Recommended: 0.25 (Buy) or 0.4 (Conservative)
# Default: 0.25
TRADE_RATING_MIN=0.25

# Prioritize candidates by TV rating (highest first) during slot allocation
# true = sort candidates by TV score before opening trades
# false = sort by combined MTF+TV score
# Default: true
TRADE_RATING_PRIORITIZE=true

# TV rating weight in combined score calculation (0.0 to 1.0)
# 0.0 = 100% MTF score, 1.0 = 100% TV score
# Recommended: 0.3 (30% TV, 70% MTF)
# Default: 0.3
TV_RATING_WEIGHT=0.3

# ============================================================================
# VOLUME FILTERING (LEGACY)
# ============================================================================

# Block trades when 24h volume change is negative
# true = require positive volume change
# false = ignore volume sign (only check if > VOLUME_MIN_CHANGE_PCT)
# Default: true
TRADE_NO_NEG_VOL=true

# Minimum market cap (USD) required to open trades
# 0 = no market cap filter
# Default: 0
MARKET_CAP_MIN=0

# ============================================================================
# TELEGRAM NOTIFICATIONS
# ============================================================================

# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram chat ID where alerts are sent (get from @userinfobot)
TELEGRAM_CHAT_ID=

# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# Enable surgical logs for API response debugging
# Shows raw API responses and data normalization details
# Default: false
DEBUG_SURGICAL_LOGS=false

# Enable diagnostic mode with verbose logging
# Useful for troubleshooting and understanding scanner flow
# Default: false
DIAGNOSTIC_MODE=false

# ============================================================================
# ADVANCED: SEED DATA SIZE
# ============================================================================

# Override KLINE_SEED_LIMIT via environment variable
# If set, overrides KLINE_SEED_LIMIT from config.py
# Default: (not set - uses KLINE_SEED_LIMIT)
SEED_KLINES_LIMIT=
