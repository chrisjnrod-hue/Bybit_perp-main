=== ENVIRONMENT VARIABLES (name : default) and DESCRIPTION ===

# Network / API
MAINNET : True
    - If true, use Bybit mainnet endpoints; if false use testnet.
USE_WS : False
    - Whether to use websockets (True/False).

BYBIT_API_KEY : "" (empty)
    - Bybit API key for authenticated operations.
BYBIT_API_SECRET : "" (empty)
    - Bybit API secret for authenticated operations.

BYBIT_WS_HOSTS : "" (not set)
    - Optional comma-separated extra WS hosts used by BybitClient (format: wss://host,...).

# Scan / timeframes / seeding
ROOT_TFS : ["60","240","D"]
    - Root timeframes scanned (numeric minute strings or "D").
MTF_TFS : ["5","15","60","240","D"]
    - Multi-timeframe list for subscriptions/monitoring.

ROOT_SCAN_INTERVAL : 120  (special: setting "0"|"false" => align to 5m candle opens)
    - Seconds between root scan cycles. If 0 (or "false"/"0") scanner aligns to 5m candle boundaries.
KLINE_SEED_LIMIT : 50
    - How many historical candles to seed per TF.

SEED_KLINES_LIMIT : (derived from KLINE_SEED_LIMIT if set)
    - Alternate name used in scanner (int(os.getenv("SEED_KLINES_LIMIT", str(KLINE_SEED_LIMIT)))).

# Concurrency / rate limiting
RATE_LIMIT_RPS : 5.0
    - Token-bucket rate limit requests per second default.
CONCURRENCY : 30
    - Max concurrent worker tasks (scanner-level).
MAX_CONCURRENT_REQUESTS : 10
    - Semaphore limit for outbound HTTP requests.
REQUEST_BATCH_SIZE : 15
    - Batch size when polling many symbols.
REQUEST_BATCH_DELAY : 0.2
    - Delay between request batches (seconds).
REST_POLL_INTERVAL : 10
    - Interval for REST poller fallback (seconds).

# Trading / Risk
TRADE_ENABLED : False
    - Whether the bot should place real orders (True) or run simulated only.
MAX_OPEN_TRADES : 3
    - Maximum concurrently open trades.
TP_PERCENT : 2.0
    - Take profit percent (config usage in code).
SL_PERCENT : 1.0
    - Stop loss percent.
BREAKEVEN_PERCENT : 0.5
    - Breakeven percent (config).
BREAKEVEN_TRIGGER_PERCENT : 1.0
    - Percent trigger for breakeven behavior.
BREAKEVEN_HL : True
    - Breakeven high/low flag.

POSITION_SIZING_MODE : "auto"
    - "auto" or "fixed".
FIXED_QTY : 1.0
    - If POSITION_SIZING_MODE=="fixed" use this qty.

# Filters / Scoring (existing)
MACD_HIST_THRESHOLD : 0.0
    - (Unused as strict gate) Threshold for MACD histogram if employed.
VOLUME_CHANGE_24H_THRESHOLD : 0.0
    - Threshold for 24h volume change.

VOLUME_FILTER_ENABLED : True
    - When true, blocks trade opens when 24h vol change is negative (trade-open gate).
VOLUME_MIN_CHANGE_PCT : 0.0
    - Minimum 24h volume change required for opens (decimal, e.g., 0.05 = +5%).

SIGNAL_FILTER_MACD_ENABLED : True
    - Include MACD contribution in the signal scoring.
SIGNAL_FILTER_VOLUME_ENABLED : True
    - Include 24h volume contribution in scoring.
SIGNAL_FILTER_SR_ENABLED : True
    - Include support/resistance proximity contribution in scoring.

SIGNAL_WEIGHT_MACD : 1.0
    - Relative weight used in existing SR scoring branch.
SIGNAL_WEIGHT_VOLUME : 1.0
    - Relative weight for volume scoring.
SIGNAL_WEIGHT_SR : 0.5
    - Relative weight for SR proximity scoring.

SIGNAL_SR_SUPPORT_WINDOW_PCT : 0.02
    - Window (pct) used to decide "near support/resistance".
SIGNAL_SR_LOOKBACK : 100
    - Lookback candles for SR calculation.

# MTF / slope
MTF_SLOPE_LOOKBACK : 3
    - Lookback for daily slope when deciding "daily_rising" MTF scenario.

# StrongBuy / TradingView-like composite rating (new)
STRONGBUY_MIN_SCORE : 0.75
    - Composite normalized score threshold to label "strongbuy".
STRONGBUY_MODERATE_SCORE : 0.60
    - Composite normalized score threshold to label "moderate".
STRONGBUY_REQUIRED_FOR_OPEN : True
    - If True, require rating == "strongbuy" for any trade opening (applies to simulated and live).

# StrongBuy indicator params (defaults)
RSI_PERIOD : 14
EMA_SHORT_PERIOD : 20
EMA_LONG_PERIOD : 50

MACD_NORM_SCALE : 0.0005
    - Scale for MACD normalization (tanh scale).
EMA_NORM_SCALE : 0.01
    - Scale for EMA proximity normalization.
VOL_NORM_SCALE : 0.05
    - Scale for 24h volume change normalization.

INDICATOR_WEIGHT_MACD : 0.30
INDICATOR_WEIGHT_RSI : 0.25
INDICATOR_WEIGHT_EMA : 0.25
INDICATOR_WEIGHT_VOL : 0.20
    - Per-indicator weights (sum normalized internally).

# Telegram
TELEGRAM_BOT_TOKEN : "" (empty)
TELEGRAM_CHAT_ID : "" (empty)
    - Telegram credentials.

# Logging / debug flags (used at runtime)
LOG_LEVEL : "INFO"
DEBUG_SURGICAL_LOGS : (env) False by default (scanner checks os.getenv("DEBUG_SURGICAL_LOGS"))
DIAGNOSTIC_MODE : (env) False by default (scanner checks os.getenv("DIAGNOSTIC_MODE"))
DEBUG_WS_LOG : (env) False by default (bybit_client reads _env_true("DEBUG_WS_LOG"))

# Others / TTL
SENT_SIGNAL_TTL : 14400  (# 60*60*4)
    - Seconds to keep sent-signal dedupe entries.

# Misc environment variables used but not in config.py
BYBIT_WS_HOSTS : "" (optional list of extra WS hosts)
    - Read directly by BybitClient from os.getenv("BYBIT_WS_HOSTS", "")
DEBUG_WS_LOG : "" (used by BybitClient; set to "1"/"true" to enable)
SEED_KLINES_LIMIT : (alternate override via env; scanner reads it from os.getenv("SEED_KLINES_LIMIT", str(KLINE_SEED_LIMIT)))

